# Supabase  (Project Settings > API)
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server only, never expose to the browser

# long random string, e.g.  openssl rand -base64 48
JWT_SECRET=change-me

# Optional: enables the AI assistant (without it the assistant falls back to keyword search)
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
